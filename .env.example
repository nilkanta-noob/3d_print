# Copy to .env.local for development, and set the same keys wherever the site deploys.
# Every value below is required: the app has no safe default for any of them.

# Postgres connection string for Prisma (prisma/schema.prisma).
DATABASE_URL="postgresql://user:password@host:5432/printwarriors"

# Resend API key. Needed at BUILD time as well as at runtime: src/lib/email.ts constructs its client
# when the module is imported, so `next build` fails without it.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Signs the short-lived token that proves an email was verified before a quote is submitted.
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=""

# Signs next-auth session cookies for the admin area. Generate the same way as JWT_SECRET.
NEXTAUTH_SECRET=""

# The site's own origin, which next-auth uses to build callback URLs. Must be the canonical www host
# in production; http://localhost:3000 in development.
NEXTAUTH_URL="https://www.printwarriors.in"

# Where quote and contact notifications are delivered.
ADMIN_EMAIL="printwarriors.in@gmail.com"
